{
  "name": "order-ingest-service",
  "version": "1.0.0",
  "description": "Backend service that uploads an orders file to GCS and ingests it into a sharded PostgreSQL setup.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/runMigrations.js",
    "test": "node --test src/tests/"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.12.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
